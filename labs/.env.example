# ==============================================================================
# KaushalAI Virtual Labs — Environment Variables Reference (.env.example)
# ==============================================================================

# Backend Server Port (default: 5001 to prevent conflicts with main platform on 5000)
PORT=5001

# Isolated MongoDB Connection URI for Virtual Labs
# Important: Note the database name 'kaushalai_labs' to isolate data from main platform
MONGODB_URI=mongodb://localhost:27017/kaushalai_labs

# Shared JWT Secret
# MUST match the JWT secret of the main KaushalAI platform backend for SSO validation in Part 2
JWT_SHARED_SECRET=your_jwt_shared_secret_here

# Base URL of Main KaushalAI Backend API (for progress webhooks and validation in Part 2 & Part 5)
MAIN_APP_API_URL=http://localhost:5000/api

# Allowed Origin for CORS (Frontend domain of main KaushalAI site; dev localhost origins are included by default)
ALLOWED_ORIGIN=http://localhost:3000

# Client Vite Configuration
# URL pointing to the Virtual Labs Express Backend
VITE_LABS_API_URL=http://localhost:5001
