# KaushalAI Virtual Labs Backend Environment Configuration

PORT=5001

# Dedicated MongoDB database specifically for virtual labs data (isolated from main platform DB)
MONGODB_URI=mongodb://localhost:27017/kaushalai_labs

# Shared JWT secret matching the main KaushalAI platform backend (for SSO token verification in Part 2)
JWT_SHARED_SECRET=your_jwt_shared_secret_here

# Base URL of the main KaushalAI website backend (for webhook completion callbacks in Part 2 & Part 5)
MAIN_APP_API_URL=http://localhost:5000/api

# Allowed Origin for CORS (main KaushalAI frontend domain; localhost is enabled by default in dev)
ALLOWED_ORIGIN=http://localhost:3000
